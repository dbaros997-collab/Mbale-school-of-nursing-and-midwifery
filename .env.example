# =============================================================================
# Mbale School of Nursing and Midwifery — environment template
# Official site: https://mbaleschoolofnursing.ac.ug
# =============================================================================
# Copy to `.env` for local development:  cp .env.example .env
#
# Microsoft 365 SSO flow:
#   /portal → MSAL redirect → Azure AD → /auth/microsoft/callback
#   → POST /api/auth/microsoft/callback (token verify + session cookie)
#
# Azure Entra ID → App registrations → your app → Authentication:
#   Platform: Single-page application
#   Redirect URIs (both if you use local dev + production):
#     http://localhost:5173/auth/microsoft/callback
#     https://mbaleschoolofnursing.ac.ug/auth/microsoft/callback
# =============================================================================

# --- Azure AD app (required for Microsoft sign-in) ---------------------------

# Client (application) ID — MUST match between public (browser) and server vars.
NEXT_PUBLIC_AZURE_CLIENT_ID=
MICROSOFT_CLIENT_ID=

# Directory (tenant) ID — MUST match between public and server vars.
NEXT_PUBLIC_AZURE_TENANT_ID=
MICROSOFT_TENANT_ID=

# Client secret — SERVER RUNTIME ONLY (Coolify env, never NEXT_PUBLIC_*).
MICROSOFT_CLIENT_SECRET=
# AZURE_CLIENT_SECRET=   # alias accepted by the app

# Full redirect URL registered in Entra (SPA). Required at Docker BUILD for production.
# Local dev (npm run dev uses port 5173):
NEXT_PUBLIC_AZURE_REDIRECT_URI=http://localhost:5173/auth/microsoft/callback
# Production (set as GitHub Actions repository variable / Docker build-arg):
# NEXT_PUBLIC_AZURE_REDIRECT_URI=https://mbaleschoolofnursing.ac.ug/auth/microsoft/callback

# Session cookie encryption (server runtime). Generate: openssl rand -base64 32
SESSION_SECRET=

# --- Site URLs ---------------------------------------------------------------

# Public site origin (no trailing slash). Used when redirect URI is not explicit.
NEXT_PUBLIC_SITE_URL=https://mbaleschoolofnursing.ac.ug
# Local override:
# NEXT_PUBLIC_APP_URL=http://localhost:5173

# --- Student portal access policy (Microsoft sign-in) ------------------------

# Primary student mailbox domain for @mbaleschoolofnursing.ac.ug accounts.
ALLOWED_EMAIL_DOMAIN=mbaleschoolofnursing.ac.ug

# Optional CSV override (takes precedence over ALLOWED_EMAIL_DOMAIN when set):
# MICROSOFT_ALLOWED_STUDENT_DOMAINS=mbaleschoolofnursing.ac.ug,student.mbsnm.org

# During Azure UPN migration, legacy student.mbsnm.org is merged by default.
# Set to false when every student uses @mbaleschoolofnursing.ac.ug only:
# MICROSOFT_INCLUDE_LEGACY_STUDENT_DOMAINS=false
# MICROSOFT_LEGACY_STUDENT_EMAIL_DOMAINS=student.mbsnm.org

# Optional: block staff legacy domains from student portal Microsoft login
# MICROSOFT_BLOCKED_EMAIL_DOMAINS=staff.mbsnm.org,mbsnm.org

# Optional: Azure AD security group object IDs (CSV)
# MICROSOFT_STUDENT_SECURITY_GROUP_IDS=
# MICROSOFT_BLOCKED_SECURITY_GROUP_IDS=

# --- SharePoint / Graph (optional — portal notices & curriculum) -------------

MICROSOFT_SHAREPOINT_SITE_ID=
MICROSOFT_SHAREPOINT_DRIVE_ID=
MICROSOFT_NOTICES_LIST_ID=
MICROSOFT_CURRICULUM_FOLDER_PATH=/Curriculum

# --- Supabase (production academic data + fee ledger) ------------------------
#
# REST/RPC (recommended for this app): set the three keys below on Coolify at RUNTIME.
# NEXT_PUBLIC_* must ALSO be set at Docker BUILD (GitHub repository variables) so the
# browser bundle and Realtime hooks match production — changing them in Coolify alone
# requires a new image build.
#
# Supabase → Project Settings → API:
#   NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
#   SUPABASE_SERVICE_ROLE_KEY=eyJ...   (server only — never NEXT_PUBLIC_*)
#
# Optional — direct Postgres (migrations / admin scripts only, not required at runtime):
#   DIRECT_DATABASE_URL=postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres
#   DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Aliases also accepted: SUPABASE_DB_DIRECT_URL, SUPABASE_DB_POOLER_URL

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Online fee payments (Flutterwave LIVE — UGX cards & Uganda mobile money) -
#
# Dashboard: https://dashboard.flutterwave.com → Settings → API keys (Live tab)
# Use LIVE keys in production (prefix FLW-PUBK-LIVE- / FLW-SECK-LIVE-).
# Coolify: set all three at RUNTIME only (never bake into Docker build).
#
# Webhook URL: https://mbaleschoolofnursing.ac.ug/api/payments/webhook
# FLUTTERWAVE_WEBHOOK_SECRET = dashboard “Secret hash” (verif-hash header).

FLUTTERWAVE_PUBLIC_KEY=FLW-PUBK-LIVE-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLW-SECK-LIVE-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_WEBHOOK_SECRET=your_live_webhook_secret_hash

# =============================================================================
# Coolify production — paste reference
# =============================================================================
# Copy/paste template (no comments): config/coolify.runtime.env.example
#
# --- Coolify application settings --------------------------------------------
#   Build pack: Dockerfile (repo root `Dockerfile` — pull-only FROM ghcr.io/...)
#   Port: 3000
#   Health check path: /api/health  (expect ok:true, build=<git sha>)
#   Do NOT run `next build` on the VPS — GitHub Actions builds via Dockerfile.build.
#
# --- GitHub → Settings → Secrets and variables → Actions → Variables --------
#   (Rebuild required when these change — baked into the client bundle.)
#   NEXT_PUBLIC_AZURE_CLIENT_ID=<same as MICROSOFT_CLIENT_ID>
#   NEXT_PUBLIC_AZURE_TENANT_ID=<same as MICROSOFT_TENANT_ID>
#   NEXT_PUBLIC_AZURE_REDIRECT_URI=https://mbaleschoolofnursing.ac.ug/auth/microsoft/callback
#   NEXT_PUBLIC_SITE_URL=https://mbaleschoolofnursing.ac.ug
#   NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
#
# --- GitHub → Secrets (optional aliases for build arg resolution) ------------
#   MICROSOFT_CLIENT_ID, MICROSOFT_TENANT_ID
#   COOLIFY_WEBHOOK=<Coolify deploy webhook URL>
#   COOLIFY_TOKEN=<optional Bearer token>
#
# --- Coolify → Environment Variables (runtime — paste block) -----------------
#   NODE_ENV=production
#   PORT=3000
#   HOSTNAME=0.0.0.0
#   MICROSOFT_CLIENT_ID=
#   MICROSOFT_TENANT_ID=
#   MICROSOFT_CLIENT_SECRET=
#   SESSION_SECRET=
#   ALLOWED_EMAIL_DOMAIN=mbaleschoolofnursing.ac.ug
#   NEXT_PUBLIC_AZURE_CLIENT_ID=          # same UUID as MICROSOFT_CLIENT_ID (MSAL at runtime)
#   NEXT_PUBLIC_AZURE_TENANT_ID=          # same UUID as MICROSOFT_TENANT_ID
#   NEXT_PUBLIC_AZURE_REDIRECT_URI=https://mbaleschoolofnursing.ac.ug/auth/microsoft/callback
#   NEXT_PUBLIC_SITE_URL=https://mbaleschoolofnursing.ac.ug
#   SUPABASE_SERVICE_ROLE_KEY=
#   FLUTTERWAVE_PUBLIC_KEY=FLW-PUBK-LIVE-...
#   FLUTTERWAVE_SECRET_KEY=FLW-SECK-LIVE-...
#   FLUTTERWAVE_WEBHOOK_SECRET=
#   MICROSOFT_SHAREPOINT_SITE_ID=         # optional
#   MICROSOFT_SHAREPOINT_DRIVE_ID=
#   MICROSOFT_NOTICES_LIST_ID=
#   MICROSOFT_CURRICULUM_FOLDER_PATH=/Curriculum
#
# --- Apply env changes in Coolify (no "Redeploy" button) ---------------------
#   Runtime secrets → Save env vars → Restart app (Runtime-only vars, Build off).
#   New Docker image → GitHub Actions finishes → Coolify app → Deploy (▶).
#   Or push to main / npm run deploy:trigger if Git webhook auto-deploy is enabled.
#
# --- Verify after deploy -----------------------------------------------------
#   GET https://mbaleschoolofnursing.ac.ug/api/health
#     → microsoft.ready, supabase.configured, flutterwave.configured
#   GET https://mbaleschoolofnursing.ac.ug/api/auth/microsoft/status?production=1
