# =============================================================================
# abale-school — environment template (Coolify + local development)
# =============================================================================
# Copy to `.env.local` for local dev, or paste into Coolify → Environment Variables.
# Do NOT commit real secrets to git.
#
# Coolify setup (General):
#   - Build pack: Dockerfile (recommended) or Nixpacks
#   - Branch: main
#   - Port: 3000 (container) → map to 443/80 via your domain
#   - Build: (Dockerfile) automatic  |  (Nixpacks) npm ci --include=dev && npm run build
#   - Start: npm run start
#
# Coolify env vars: mark NEXT_PUBLIC_* as available at BUILD TIME and RUNTIME
# so they are inlined during `next build` and readable on the server.
# =============================================================================

# ── Runtime (Coolify / Docker) ───────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Public URL users visit (no trailing slash). Replace with your live domain.
# Examples: https://your-domain.com  |  https://your-app.coolify.example.com
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Node heap for builds — already set in Dockerfile (builder) and nixpacks.toml.
# Override here only if Coolify uses a custom build command without those files.
# NODE_OPTIONS=--max-old-space-size=3072

# =============================================================================
# Microsoft 365 / Azure AD — Student Portal SSO
# =============================================================================
# Register at: https://portal.azure.com → Microsoft Entra ID → App registrations
#
# Authentication → Single-page application → Redirect URIs (register ALL you use):
#   Local:        http://localhost:3000/auth/microsoft/callback
#   Production:   https://your-domain.com/auth/microsoft/callback
#
# API permissions (Delegated) — Grant admin consent:
#   openid, profile, email, offline_access, User.Read, Calendars.Read,
#   Sites.Read.All, Files.Read.All, GroupMember.Read.All
#
# Certificates & secrets → New client secret → AZURE_CLIENT_SECRET

NEXT_PUBLIC_AZURE_CLIENT_ID=
NEXT_PUBLIC_AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# Production callback (must match Azure SPA redirect URI exactly)
NEXT_PUBLIC_AZURE_REDIRECT_URI=https://your-domain.com/auth/microsoft/callback

# Local-only override (use in .env.local, not Coolify):
# NEXT_PUBLIC_AZURE_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

# HttpOnly session cookie encryption — 32+ random characters
# Generate: openssl rand -base64 32
SESSION_SECRET=

# =============================================================================
# Access control — Microsoft SSO for the student portal
# =============================================================================
# Allowed if EITHER:
#   A) Email domain is in MICROSOFT_ALLOWED_STUDENT_DOMAINS
#   B) User is in a group listed in MICROSOFT_STUDENT_SECURITY_GROUP_IDS
#
# Blocked if in MICROSOFT_BLOCKED_SECURITY_GROUP_IDS, or on a blocked domain
# without also being in an allowed student group.

MICROSOFT_ALLOWED_STUDENT_DOMAINS=student.mbsnm.org
MICROSOFT_STUDENT_SECURITY_GROUP_IDS=
MICROSOFT_BLOCKED_SECURITY_GROUP_IDS=
MICROSOFT_BLOCKED_EMAIL_DOMAINS=staff.mbsnm.org,mbsnm.org

# =============================================================================
# SharePoint — notices & curriculum on /portal/notices
# =============================================================================
# Graph Explorer: https://developer.microsoft.com/en-us/graph/graph-explorer
#   GET /sites/{hostname}:/{site-path}
#   GET /sites/{site-id}/drives
#   GET /sites/{site-id}/lists

MICROSOFT_SHAREPOINT_SITE_ID=
MICROSOFT_SHAREPOINT_DRIVE_ID=
MICROSOFT_CURRICULUM_FOLDER_PATH=/Curriculum
MICROSOFT_NOTICES_LIST_ID=

# =============================================================================
# Supabase (optional)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
