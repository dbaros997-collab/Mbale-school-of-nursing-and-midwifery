# Paste into Coolify → Configuration → Environment Variables (Production).
# For each secret: disable "Build Variable", enable "Runtime Variable" only.
# After Save → use Restart on the app (Coolify has Deploy / Restart, not "Redeploy").
# Generate SESSION_SECRET: openssl rand -base64 32
#
# NEXT_PUBLIC_SUPABASE_* are baked at GitHub Actions build time — set them there too
# when you change Supabase projects. Coolify-only changes need a GitHub rebuild + Deploy.

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=
SESSION_SECRET=

NEXT_PUBLIC_AZURE_CLIENT_ID=
NEXT_PUBLIC_AZURE_TENANT_ID=
NEXT_PUBLIC_AZURE_REDIRECT_URI=https://mbaleschoolofnursing.ac.ug/auth/microsoft/callback
NEXT_PUBLIC_SITE_URL=https://mbaleschoolofnursing.ac.ug

ALLOWED_EMAIL_DOMAIN=mbaleschoolofnursing.ac.ug

SUPABASE_SERVICE_ROLE_KEY=

FLUTTERWAVE_PUBLIC_KEY=FLW-PUBK-LIVE-
FLUTTERWAVE_SECRET_KEY=FLW-SECK-LIVE-
FLUTTERWAVE_WEBHOOK_SECRET=

MICROSOFT_SHAREPOINT_SITE_ID=
MICROSOFT_SHAREPOINT_DRIVE_ID=
MICROSOFT_NOTICES_LIST_ID=
MICROSOFT_CURRICULUM_FOLDER_PATH=/Curriculum
